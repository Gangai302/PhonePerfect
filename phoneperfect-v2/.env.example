# PhonePerfect 2.0 Environment Configuration

# Application
PROJECT_NAME="PhonePerfect 2.0"
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-super-secure-change-in-production-2026

# Database
# Default SQLite for local standalone development:
DATABASE_URL=sqlite:///./phoneperfect_v2.db

# Production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phoneperfect_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phoneperfect_v2

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
